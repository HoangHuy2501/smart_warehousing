# Port cua Express server (mac dinh 3000)
PORT=3000

# Docker Compose development: app + receipt-worker + Redis + ngrok.
# DB_MODE va PORT trong Compose lan luot la sqlserver va 3000.
# Dien cac gia tri SQL Server, JWT, Redis va ngrok ben duoi.
# APP_PORT=3000
# REDIS_PREFIX=smart-whs-development
NGROK_AUTHTOKEN=

# ============================================================
# SECRET KY JWT (HS256) — login xuat token 365 ngay
# Nen dat JWT_SECRET manh (vi du: openssl rand -hex 32).
# ============================================================
JWT_SECRET=

# ============================================================
# CHE DO DB (thu tu uu tien: sqlserver > test-postgres > memory)
#   sqlserver      : SQL Server that cua team (quy trinh chuan)
#   test-postgres  : PostgreSQL test rieng cua MiaoDa trong sandbox
#   memory         : khong DB — du lieu mock trong RAM, mat khi restart
# Neu khong khai bao DB_MODE thi tu doan theo bien moi truong co mat.
# ============================================================
DB_MODE=sqlserver

# ---------- SQL Server (che do chinh cua team) ----------
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERT=false

# SQL Server phai co san schema va du lieu phu hop; Compose khong chay migration.
# Tien to ten bang neu can (mac dinh rong).
# DB_TABLE_PREFIX=

# ---------- PostgreSQL test (chi dung trong sandbox MiaoDa) ----------
# Khong khai bao gi them — doc SUDA_DATABASE_URL tu moi truong sandbox.
# DB_MODE=test-postgres

# ---------- In-memory (demo khong can DB) ----------
# DB_MODE=memory
# ============================================================
# REDIS CHO BULLMQ WORKER (xem docs/WORKERS.md)
#   API enqueue receipt-sync vao Redis; worker xu ly queue va sweep dinh ky.
#   API va worker phai dung chung SQL Server va REDIS_PREFIX.
# ============================================================
# Compose tu ket noi Redis qua hostname redis:6379 (khong publish ra host).
# Dat mat khau manh, khac mat khau SQL Server/JWT.
REDIS_PASSWORD=
# REDIS_DB=0

# So allocation pending moi lan sweep (cron 5 phut)
# RECEIPT_SYNC_BATCH_SIZE=200

# So job sync chay song song trong 1 worker process
# WORKER_RECEIPT_CONCURRENCY=5
